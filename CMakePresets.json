{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 1,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SYSTEM_VERSION": "10.0.28000.0",
        "AZZS_ENABLE_STARTUP_DIAGNOSTIC_DEVICE_DATA_ROOT": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AZZS_ENABLE_STARTUP_DIAGNOSTIC_DEVICE_DATA_ROOT": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "architecture": "x64",
      "toolset": "v145",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.28000.0",
        "AZZS_ENABLE_STARTUP_DIAGNOSTIC_DEVICE_DATA_ROOT": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/windows-arm64",
      "architecture": "ARM64",
      "toolset": "v145",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.28000.0",
        "AZZS_ENABLE_STARTUP_DIAGNOSTIC_DEVICE_DATA_ROOT": "OFF",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host-guardrails",
      "displayName": "Host architecture and headless guardrails",
      "steps": [
        {
          "type": "configure",
          "name": "host-debug"
        },
        {
          "type": "build",
          "name": "host-debug"
        },
        {
          "type": "test",
          "name": "host-debug"
        }
      ]
    }
  ]
}
