#endif

IDI_APP_ICON ICON "..\\..\\..\\..\\assets\\product\\generated\\windows\\windows-initial-setup-workbench.ico"

STRINGTABLE
BEGIN
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_TITLE "无法进入工作台"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_RESOURCES "界面资源初始化失败。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_WINDOW "工作台未能创建启动窗口。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_UNEXPECTED "工作台启动失败。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_STARTUP_FAILURE "工作台未能启动。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_PAGE_HEADER_FALLBACK_TITLE "页面"
  AZZS_NATIVE_STRING_SETTINGS_NAVIGATION_FAILED_TITLE "应用设置暂时无法打开"
  AZZS_NATIVE_STRING_SETTINGS_NAVIGATION_FAILED_MESSAGE "设置数据或页面资源读取失败。现有页面已保留，请重试或返回当前页面。"
END

1 VERSIONINFO
 FILEVERSION AZZS_WINDOWS_VERSION_COMMAS
 PRODUCTVERSION AZZS_WINDOWS_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "CoolPlume\0"
      VALUE "FileDescription", "Windows 初装工作台：帮助新装 Windows 完成驱动准备、系统优化、常用软件安装和软件优化。\0"
      VALUE "FileVersion", AZZS_WINDOWS_VERSION "\0"
      VALUE "InternalName", "Azzs.WinUI.exe\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 CoolPlume\0"
      VALUE "OriginalFilename", "Azzs.WinUI.exe\0"
      VALUE "ProductName", "Windows 初装工作台\0"
      VALUE "ProductVersion", AZZS_APPLICATION_VERSION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
