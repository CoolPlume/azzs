STRINGTABLE
BEGIN
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_TITLE "无法进入工作台"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_RESOURCES "界面资源初始化失败。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_WINDOW "工作台未能创建启动窗口。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_APP_STARTUP_FAILURE_UNEXPECTED "工作台启动失败。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_STARTUP_FAILURE "工作台未能启动。请重新启动工作台；如果问题持续，请收集诊断资料。"
  AZZS_NATIVE_STRING_PAGE_HEADER_FALLBACK_TITLE "页面"
  AZZS_NATIVE_STRING_SETTINGS_NAVIGATION_FAILED_TITLE "应用设置暂时无法打开"
  AZZS_NATIVE_STRING_SETTINGS_NAVIGATION_FAILED_MESSAGE "设置数据或页面资源读取失败。现有页面已保留，请重试或返回当前页面。"
  // Keep the runtime-generated overview presentation localized even when the
  // packaged ResourceLoader catalog is unavailable. The fields are ordered
  // to match GuidedInitializationPresentationText in the UI adapter.
  AZZS_NATIVE_STRING_OVERVIEW_GUIDED_PRESENTATION "推荐初始化摘要|推荐初始化|已完成：|；已识别外部安装：|；部分完成：|；失败：|；已跳过：|；无适用项目：|；未执行：|；等待确认结果：|；等待资源管理器重启：|；等待 Windows 重启：|；已紧急撤回：|。请先查看当前阶段，再继续操作。|开始推荐初始化|刷新状态|取消流程|查看历史与日志|暂时跳过此阶段|继续|从专属页面重试|打开专属页面|软件目录身份|正在使用本机试用目录|此目录已通过本机加载检查，但尚未通过正式发布检查。之后创建的任务会使用它。|外部安装交接|外部安装交接|正在等待外部安装完成，之后还需要重新检查。|已识别外部安装。请核对结果后再继续。|继续此交接|推荐初始化恢复|推荐初始化处于只读状态|流程记录的持久化状态需要先修复，当前不能安全修改。|流程状态为只读|当前流程尚未记录此阶段。|原始系统信息：|原始错误信息：|驱动|系统优化|软件安装|软件优化|未知阶段|等待执行|正在执行|已完成|已跳过|没有适用项目|部分完成|执行失败|等待确认结果|等待资源管理器重启|等待 Windows 重启|已紧急撤回|等待外部安装交接|未执行"
END

1 VERSIONINFO
 FILEVERSION AZZS_WINDOWS_VERSION_COMMAS
 PRODUCTVERSION AZZS_WINDOWS_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "CoolPlume\0"
      VALUE "FileDescription", "Windows 初装工作台：帮助新装 Windows 完成驱动准备、系统优化、常用软件安装和软件优化。\0"
      VALUE "FileVersion", AZZS_WINDOWS_VERSION "\0"
      VALUE "InternalName", "Azzs.WinUI.exe\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 CoolPlume\0"
      VALUE "OriginalFilename", "Azzs.WinUI.exe\0"
      VALUE "ProductName", "Windows 初装工作台\0"
      VALUE "ProductVersion", AZZS_APPLICATION_VERSION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
