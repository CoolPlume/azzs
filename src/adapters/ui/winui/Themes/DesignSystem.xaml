<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AzzsSurfaceRootBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="AzzsSurfaceContentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsSurfaceRaisedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsSurfaceBorderBrush" Color="#24000000" />
            <SolidColorBrush x:Key="AzzsTextPrimaryBrush" Color="#E6000000" />
            <SolidColorBrush x:Key="AzzsTextSecondaryBrush" Color="#99000000" />
            <SolidColorBrush x:Key="AzzsStatusNeutralBrush" Color="#FF4F5B66" />
            <SolidColorBrush x:Key="AzzsStatusInformationBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="AzzsStatusSuccessBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="AzzsStatusWarningBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="AzzsStatusErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AzzsRiskLowBrush" Color="#FF4F5B66" />
            <SolidColorBrush x:Key="AzzsRiskMediumBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="AzzsRiskHighBrush" Color="#FFD83B01" />
            <SolidColorBrush x:Key="AzzsRiskCriticalBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AzzsCommandPrimaryBrush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="AzzsCommandSecondaryBrush" Color="#FFE9E9E9" />
            <SolidColorBrush x:Key="AzzsCommandDangerBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AzzsCommandOnAccentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsCommandOnDangerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsMaterialRootFallbackBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="AzzsMaterialFlyoutFallbackBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsFocusBrush" Color="#FF005FB8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AzzsSurfaceRootBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="AzzsSurfaceContentBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="AzzsSurfaceRaisedBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="AzzsSurfaceBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="AzzsTextPrimaryBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="AzzsTextSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="AzzsStatusNeutralBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="AzzsStatusInformationBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AzzsStatusSuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="AzzsStatusWarningBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="AzzsStatusErrorBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="AzzsRiskLowBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="AzzsRiskMediumBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="AzzsRiskHighBrush" Color="#FFFF8C00" />
            <SolidColorBrush x:Key="AzzsRiskCriticalBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="AzzsCommandPrimaryBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AzzsCommandSecondaryBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="AzzsCommandDangerBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AzzsCommandOnAccentBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="AzzsCommandOnDangerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AzzsMaterialRootFallbackBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="AzzsMaterialFlyoutFallbackBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="AzzsFocusBrush" Color="#FF60CDFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AzzsSurfaceRootBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsSurfaceContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsSurfaceBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AzzsTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AzzsTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AzzsStatusNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AzzsStatusInformationBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsStatusSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsStatusWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsStatusErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsRiskLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AzzsRiskMediumBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsRiskHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsRiskCriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsCommandPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsCommandSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsCommandDangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AzzsCommandOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AzzsCommandOnDangerBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AzzsMaterialRootFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsMaterialFlyoutFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AzzsFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="AzzsSpaceNone">0</x:Double>
    <x:Double x:Key="AzzsSpaceCompact">4</x:Double>
    <x:Double x:Key="AzzsSpaceSmall">8</x:Double>
    <x:Double x:Key="AzzsSpaceMedium">12</x:Double>
    <x:Double x:Key="AzzsSpaceStandard">16</x:Double>
    <x:Double x:Key="AzzsSpaceLarge">24</x:Double>
    <x:Double x:Key="AzzsSpaceExtraLarge">32</x:Double>
    <x:Double x:Key="AzzsTouchTargetMinHeight">44</x:Double>
    <x:Double x:Key="AzzsStageMinimumWidth">144</x:Double>
    <x:Double x:Key="AzzsWideLayoutMinWidth">960</x:Double>
    <x:Double x:Key="AzzsContentMaxWidth">1280</x:Double>

    <Thickness x:Key="AzzsPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="AzzsPagePaddingNarrow">16,16,16,24</Thickness>
    <Thickness x:Key="AzzsSectionPadding">16</Thickness>
    <Thickness x:Key="AzzsListRowPadding">12,10</Thickness>
    <Thickness x:Key="AzzsCommandPadding">16,8</Thickness>
    <Thickness x:Key="AzzsShellStatusMargin">24,16,24,0</Thickness>
    <Thickness x:Key="AzzsStageItemMargin">0,0,8,8</Thickness>
    <Thickness x:Key="AzzsBorderThickness">1</Thickness>

    <CornerRadius x:Key="AzzsCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="AzzsCornerRadiusMedium">8</CornerRadius>

    <FontFamily x:Key="AzzsFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="AzzsIconFontFamily">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="AzzsFontSizeCaption">12</x:Double>
    <x:Double x:Key="AzzsFontSizeBody">14</x:Double>
    <x:Double x:Key="AzzsFontSizeSection">20</x:Double>
    <x:Double x:Key="AzzsFontSizePageTitle">28</x:Double>

    <x:String x:Key="AzzsIconInformation">&#xE946;</x:String>
    <x:String x:Key="AzzsIconSuccess">&#xE73E;</x:String>
    <x:String x:Key="AzzsIconWarning">&#xE7BA;</x:String>
    <x:String x:Key="AzzsIconError">&#xEA39;</x:String>
    <x:String x:Key="AzzsIconDisabledReason">&#xE711;</x:String>
    <x:String x:Key="AzzsIconRisk">&#xE7BA;</x:String>
    <x:String x:Key="AzzsIconProgress">&#xE9D9;</x:String>
    <x:String x:Key="AzzsIconWaiting">&#xE823;</x:String>
    <x:String x:Key="AzzsIconEmergencyWithdrawal">&#xE7A7;</x:String>
    <x:String x:Key="AzzsIconResultLocator">&#xE707;</x:String>

    <Duration x:Key="AzzsMotionDurationImmediate">0:0:0</Duration>
    <Duration x:Key="AzzsMotionDurationFeedback">0:0:0.083</Duration>
    <Duration x:Key="AzzsMotionDurationState">0:0:0.167</Duration>
    <Duration x:Key="AzzsMotionDurationOverlay">0:0:0.250</Duration>
    <CubicEase x:Key="AzzsMotionCurveEnter" EasingMode="EaseOut" />
    <CubicEase x:Key="AzzsMotionCurveMove" EasingMode="EaseOut" />
    <CubicEase x:Key="AzzsMotionCurveExit" EasingMode="EaseOut" />

    <Style x:Key="AzzsPageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="AzzsPageRootGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource AzzsPagePaddingNarrow}" />
        <Setter Property="RowSpacing" Value="{StaticResource AzzsSpaceStandard}" />
        <Setter Property="MaxWidth" Value="{StaticResource AzzsContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="AzzsPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AzzsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AzzsFontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="AzzsSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AzzsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AzzsFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AzzsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AzzsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AzzsFontSizeBody}" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="AzzsMetadataTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AzzsBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource AzzsFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextSecondaryBrush}" />
    </Style>

    <Style x:Key="AzzsDisabledReasonTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AzzsBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextSecondaryBrush}" />
    </Style>

    <Style x:Key="AzzsPrimaryNavigationStyle" TargetType="NavigationView">
        <Setter Property="IsBackButtonVisible" Value="Collapsed" />
        <Setter Property="IsSettingsVisible" Value="False" />
        <Setter Property="PaneDisplayMode" Value="Auto" />
        <Setter Property="Background" Value="{ThemeResource AzzsMaterialRootFallbackBrush}" />
    </Style>

    <Style x:Key="AzzsSectionSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AzzsSurfaceContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AzzsSurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AzzsBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AzzsCornerRadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource AzzsSectionPadding}" />
    </Style>

    <Style x:Key="AzzsListRowSurfaceStyle" TargetType="Border" BasedOn="{StaticResource AzzsSectionSurfaceStyle}">
        <Setter Property="Padding" Value="{StaticResource AzzsListRowPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource AzzsTouchTargetMinHeight}" />
    </Style>

    <Style x:Key="AzzsDetailSurfaceStyle" TargetType="Border" BasedOn="{StaticResource AzzsSectionSurfaceStyle}" />
    <Style x:Key="AzzsSummarySurfaceStyle" TargetType="Border" BasedOn="{StaticResource AzzsSectionSurfaceStyle}" />
    <Style x:Key="AzzsRiskConfirmationSurfaceStyle" TargetType="Border" BasedOn="{StaticResource AzzsSectionSurfaceStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource AzzsRiskCriticalBrush}" />
    </Style>

    <Style x:Key="AzzsStatusBandStyle" TargetType="InfoBar">
        <Setter Property="IsClosable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource AzzsTouchTargetMinHeight}" />
    </Style>

    <Style x:Key="AzzsInformationStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsStatusBandStyle}">
        <Setter Property="Severity" Value="Informational" />
    </Style>

    <Style x:Key="AzzsWarningStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsStatusBandStyle}">
        <Setter Property="Severity" Value="Warning" />
    </Style>

    <Style x:Key="AzzsErrorStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsStatusBandStyle}">
        <Setter Property="Severity" Value="Error" />
    </Style>

    <Style x:Key="AzzsInlineErrorStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsErrorStatusBandStyle}" />

    <Style x:Key="AzzsWaitingStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsInformationStatusBandStyle}" />

    <Style x:Key="AzzsFailureStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsErrorStatusBandStyle}" />

    <Style x:Key="AzzsPendingStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsWarningStatusBandStyle}" />

    <Style x:Key="AzzsEmergencyWithdrawalStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsWarningStatusBandStyle}" />

    <Style x:Key="AzzsLocalTrialStatusBandStyle" TargetType="InfoBar" BasedOn="{StaticResource AzzsWarningStatusBandStyle}" />

    <Style x:Key="AzzsProgressStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="AzzsCommandButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AzzsFontFamily}" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource AzzsTouchTargetMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource AzzsCommandPadding}" />
    </Style>

    <Style x:Key="AzzsPrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource AzzsCommandButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AzzsCommandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsCommandOnAccentBrush}" />
    </Style>

    <Style x:Key="AzzsSecondaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource AzzsCommandButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AzzsCommandSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsTextPrimaryBrush}" />
    </Style>

    <Style x:Key="AzzsDangerCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource AzzsCommandButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AzzsCommandDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AzzsCommandOnDangerBrush}" />
    </Style>

    <Style x:Key="AzzsResultLocatorButtonStyle" TargetType="Button" BasedOn="{StaticResource AzzsSecondaryCommandButtonStyle}" />

    <Style x:Key="AzzsReadOnlyListStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</ResourceDictionary>
