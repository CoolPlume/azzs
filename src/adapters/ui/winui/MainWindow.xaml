<Window
    x:Class="Azzs.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid
        x:Name="ShellRoot"
        SizeChanged="OnShellSizeChanged">
        <NavigationView
            x:Name="PrimaryNavigation"
            AutomationProperties.AutomationId="AzzsPrimaryNavigation"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            OpenPaneLength="248"
            SelectionChanged="OnNavigationSelectionChanged"
            Style="{StaticResource AzzsPrimaryNavigationStyle}">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="OverviewItem"
                x:Uid="NavigationOverview"
                AutomationProperties.AutomationId="AzzsNavigationOverview"
                IsSelected="True"
                TabIndex="0"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="HardwareInformationItem"
                x:Uid="NavigationHardwareInformation"
                AutomationProperties.AutomationId="AzzsNavigationHardwareInformation"
                TabIndex="1"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="SystemInformation" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="DriversItem"
                x:Uid="NavigationDrivers"
                AutomationProperties.AutomationId="AzzsNavigationDrivers"
                TabIndex="2"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Manage" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SystemOptimizationItem"
                x:Uid="NavigationSystemOptimization"
                AutomationProperties.AutomationId="AzzsNavigationSystemOptimization"
                TabIndex="3"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SoftwareInstallationItem"
                x:Uid="NavigationSoftwareInstallation"
                AutomationProperties.AutomationId="AzzsNavigationSoftwareInstallation"
                TabIndex="4"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SoftwareOptimizationItem"
                x:Uid="NavigationSoftwareOptimization"
                AutomationProperties.AutomationId="AzzsNavigationSoftwareOptimization"
                TabIndex="5"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="HistoryAndLogsItem"
                x:Uid="NavigationHistoryAndLogs"
                AutomationProperties.AutomationId="AzzsNavigationHistoryAndLogs"
                TabIndex="6"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="ApplicationSettingsItem"
                x:Uid="NavigationApplicationSettings"
                AutomationProperties.AutomationId="AzzsNavigationApplicationSettings"
                TabIndex="7"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SoftwareCatalogEditorItem"
                x:Uid="NavigationSoftwareCatalogEditor"
                AutomationProperties.AutomationId="AzzsNavigationSoftwareCatalogEditor"
                TabIndex="8"
                Visibility="Collapsed"
                Style="{StaticResource AzzsNavigationItemStyle}">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource AzzsSurfaceRootBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="VersionRiskInfoBar"
                AutomationProperties.AutomationId="AzzsVersionRiskInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Visibility="Collapsed"
                Margin="{StaticResource AzzsShellStatusMargin}"
                Severity="Warning"
                Style="{StaticResource AzzsStatusBandStyle}" />
            <InfoBar
                x:Name="RecoveredCatalogEditorInfoBar"
                Grid.Row="1"
                x:Uid="MainWindowRecoveredCatalogEditor"
                AutomationProperties.AutomationId="AzzsRecoveredCatalogEditorInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Visibility="Collapsed"
                Margin="{StaticResource AzzsShellStatusMargin}"
                Severity="Warning"
                Style="{StaticResource AzzsStatusBandStyle}">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="ContinueRecoveredCatalogEditorButton"
                        x:Uid="MainWindowContinueRecoveredCatalogEditor"
                        AutomationProperties.AutomationId="AzzsContinueRecoveredCatalogEditor"
                        Click="OnContinueRecoveredCatalogEditorClick"
                        Style="{StaticResource AzzsSecondaryCommandButtonStyle}">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}"><SymbolIcon Symbol="Edit" /><TextBlock x:Uid="MainWindowContinueRecoveredCatalogEditorLabel" /></StackPanel></Button.Content>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="SettingsNavigationFailureInfoBar"
                Grid.Row="2"
                x:Uid="MainWindowSettingsNavigationFailed"
                AutomationProperties.AutomationId="AzzsSettingsNavigationFailureInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Visibility="Collapsed"
                Margin="{StaticResource AzzsShellStatusMargin}"
                Severity="Error"
                Style="{StaticResource AzzsErrorStatusBandStyle}">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="RetrySettingsNavigationButton"
                        x:Uid="MainWindowRetrySettingsNavigation"
                        AutomationProperties.AutomationId="AzzsRetrySettingsNavigation"
                        Click="OnRetrySettingsNavigationClick"
                        Style="{StaticResource AzzsSecondaryCommandButtonStyle}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button
                        x:Name="ReturnToCurrentPageButton"
                        x:Uid="MainWindowReturnToCurrentPage"
                        AutomationProperties.AutomationId="AzzsReturnToCurrentPage"
                        Click="OnReturnToCurrentPageClick"
                        Style="{StaticResource AzzsSecondaryCommandButtonStyle}" />
                </InfoBar.Content>
            </InfoBar>
            <Frame
                x:Name="ContentFrame"
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsContentFrame"
                IsNavigationStackEnabled="False" />
        </Grid>
        </NavigationView>
        <primitives:Thumb
            x:Name="SidebarResizeThumb"
            x:Uid="SidebarResizeThumb"
            AutomationProperties.AutomationId="AzzsSidebarResizeThumb"
            Background="Transparent"
            Canvas.ZIndex="10"
            DragCompleted="OnSidebarResizeDragCompleted"
            DragDelta="OnSidebarResizeDragDelta"
            DragStarted="OnSidebarResizeDragStarted"
            IsTabStop="True"
            KeyDown="OnSidebarResizeKeyDown"
            Margin="{StaticResource AzzsSidebarResizeThumbInitialMargin}"
            TabIndex="1"
            Style="{StaticResource AzzsSidebarResizeThumbStyle}"
            VerticalAlignment="Stretch"
            Visibility="Collapsed"
            />
    </Grid>
</Window>
