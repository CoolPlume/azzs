<Page
    x:Class="Azzs.Ui.DesignSystem.Fixtures.DesignSystemFixturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsDesignSystemFixturePage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid
            x:Name="FixtureRoot"
            AutomationProperties.AutomationId="AzzsFixtureRoot"
            Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FixtureRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" />
                            <Setter Target="AdvancedViewPanel.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedViewPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SharedViewSecondColumn.Width" Value="0" />
                            <Setter Target="SharedViewGrid.ColumnSpacing" Value="0" />
                            <Setter Target="SharedViewGrid.RowSpacing" Value="{StaticResource AzzsSpaceStandard}" />
                            <Setter Target="ReadOnlyField.(Grid.Column)" Value="0" />
                            <Setter Target="ReadOnlyField.(Grid.Row)" Value="1" />
                            <Setter Target="FieldHelpText.(Grid.Column)" Value="0" />
                            <Setter Target="FieldHelpText.(Grid.Row)" Value="2" />
                            <Setter Target="SettingsValueColumn.Width" Value="0" />
                            <Setter Target="SettingsFormGrid.ColumnSpacing" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FixtureRoot.Padding" Value="{StaticResource AzzsPagePadding}" />
                            <Setter Target="AdvancedViewPanel.(Grid.Column)" Value="1" />
                            <Setter Target="AdvancedViewPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SharedViewSecondColumn.Width" Value="*" />
                            <Setter Target="SharedViewGrid.ColumnSpacing" Value="{StaticResource AzzsSpaceStandard}" />
                            <Setter Target="SharedViewGrid.RowSpacing" Value="0" />
                            <Setter Target="ReadOnlyField.(Grid.Column)" Value="1" />
                            <Setter Target="ReadOnlyField.(Grid.Row)" Value="0" />
                            <Setter Target="FieldHelpText.(Grid.Column)" Value="1" />
                            <Setter Target="FieldHelpText.(Grid.Row)" Value="1" />
                            <Setter Target="SettingsValueColumn.Width" Value="*" />
                            <Setter Target="SettingsFormGrid.ColumnSpacing" Value="{StaticResource AzzsSpaceStandard}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="{StaticResource AzzsSpaceSmall}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource AzzsPageTitleTextStyle}"
                    Text="设计系统固定夹具" />
                <TextBlock
                    Style="{StaticResource AzzsMetadataTextStyle}"
                    Text="仅验证呈现、命令可发现性和无障碍合同；不代表任何消费者业务通过。" />
            </StackPanel>

            <ItemsControl
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsFixtureFourStageSummary"
                AutomationProperties.Name="四阶段顺序"
                IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Border
                    x:Name="StageDriversSurface"
                    Margin="{StaticResource AzzsStageItemMargin}"
                    MinWidth="{StaticResource AzzsStageMinimumWidth}"
                    Style="{StaticResource AzzsListRowSurfaceStyle}">
                    <TextBlock x:Name="StageDriversText" Style="{StaticResource AzzsBodyTextStyle}" />
                </Border>
                <Border
                    x:Name="StageSystemOptimizationSurface"
                    Margin="{StaticResource AzzsStageItemMargin}"
                    MinWidth="{StaticResource AzzsStageMinimumWidth}"
                    Style="{StaticResource AzzsListRowSurfaceStyle}">
                    <TextBlock x:Name="StageSystemOptimizationText" Style="{StaticResource AzzsBodyTextStyle}" />
                </Border>
                <Border
                    x:Name="StageSoftwareInstallationSurface"
                    Margin="{StaticResource AzzsStageItemMargin}"
                    MinWidth="{StaticResource AzzsStageMinimumWidth}"
                    Style="{StaticResource AzzsListRowSurfaceStyle}">
                    <TextBlock x:Name="StageSoftwareInstallationText" Style="{StaticResource AzzsBodyTextStyle}" />
                </Border>
                <Border
                    x:Name="StageSoftwareOptimizationSurface"
                    Margin="{StaticResource AzzsStageItemMargin}"
                    MinWidth="{StaticResource AzzsStageMinimumWidth}"
                    Style="{StaticResource AzzsListRowSurfaceStyle}">
                    <TextBlock x:Name="StageSoftwareOptimizationText" Style="{StaticResource AzzsBodyTextStyle}" />
                </Border>
            </ItemsControl>

            <Expander
                x:Name="FixtureSummaryExpander"
                Grid.Row="2"
                AutomationProperties.AutomationId="AzzsFixtureSummaryExpander"
                AutomationProperties.Name="摘要与分组"
                Header="摘要与分组"
                IsExpanded="True"
                TabIndex="10">
                <controls:ReadOnlyPresentationSurface x:Name="SummarySurface" />
            </Expander>

            <ListView
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsFixturePresentationList"
                AutomationProperties.Name="只读呈现列表"
                Style="{StaticResource AzzsReadOnlyListStyle}">
                <ListViewItem IsTabStop="False">
                    <controls:ReadOnlyPresentationSurface x:Name="LongChineseSurface" />
                </ListViewItem>
            </ListView>

            <Grid
                x:Name="SharedViewGrid"
                Grid.Row="4"
                AutomationProperties.AutomationId="AzzsFixtureSharedViewSource"
                ColumnSpacing="{StaticResource AzzsSpaceStandard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SharedViewSecondColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock Style="{StaticResource AzzsMetadataTextStyle}" Text="标准视图" />
                    <controls:ReadOnlyPresentationSurface x:Name="StandardSharedSurface" />
                </StackPanel>
                <StackPanel
                    x:Name="AdvancedViewPanel"
                    Grid.Column="1"
                    Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock Style="{StaticResource AzzsMetadataTextStyle}" Text="高级视图" />
                    <controls:ReadOnlyPresentationSurface x:Name="AdvancedSharedSurface" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="5" Spacing="{StaticResource AzzsSpaceSmall}">
                <controls:ReadOnlyPresentationSurface x:Name="LocalTrialStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="RecoveredUnsavedStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="SavedNotAppliedStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="SourceHandoffStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="WaitingNetworkStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="InlineErrorStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="WaitingRestartStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="FailureStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="PendingConfirmationStatus" />
                <controls:ReadOnlyPresentationSurface x:Name="EmergencyWithdrawalStatus" />
            </StackPanel>

            <StackPanel
                Grid.Row="6"
                Spacing="{StaticResource AzzsSpaceStandard}">
                <controls:ReadOnlyPresentationSurface x:Name="DeterminateProgressSurface" />
                <controls:ReadOnlyPresentationSurface x:Name="UnknownProgressSurface" />
            </StackPanel>

            <controls:ReadOnlyPresentationSurface
                x:Name="DisabledReasonSurface"
                Grid.Row="7" />

            <controls:ReadOnlyPresentationSurface
                x:Name="RiskConfirmationSurface"
                Grid.Row="8" />

            <controls:ReadOnlyPresentationSurface
                x:Name="ResultLocatorSurface"
                Grid.Row="9" />

            <Grid
                x:Name="SettingsFormGrid"
                Grid.Row="10"
                ColumnSpacing="{StaticResource AzzsSpaceStandard}"
                RowSpacing="{StaticResource AzzsSpaceSmall}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SettingsValueColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SettingsFieldLabel" Style="{StaticResource AzzsBodyTextStyle}" />
                <TextBox
                    x:Name="ReadOnlyField"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AzzsFixtureReadOnlyField"
                    AutomationProperties.Name="设置字段固定值"
                    IsReadOnly="True"
                    TabIndex="50"
                    Text="固定只读值，不保存第二份业务状态" />
                <TextBlock
                    x:Name="FieldHelpText"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="字段说明"
                    Style="{StaticResource AzzsMetadataTextStyle}"
                    Text="字段错误紧邻控件显示，并可从汇总定位。" />
            </Grid>

            <Border
                x:Name="CatalogEditorSurface"
                Grid.Row="11"
                Style="{StaticResource AzzsSectionSurfaceStyle}">
                <TextBlock
                    x:Name="CatalogEditorText"
                    Style="{StaticResource AzzsBodyTextStyle}"
                    Text="目录编辑器夹具不会保存、应用、下载、安装或执行系统修改。" />
            </Border>

            <TextBlock
                x:Name="LastIntentText"
                Grid.Row="12"
                AutomationProperties.AutomationId="AzzsFixtureLastIntent"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource AzzsMetadataTextStyle}"
                Text="尚未发出类型化意图。" />
        </Grid>
    </ScrollViewer>
</Page>
