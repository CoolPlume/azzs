<Page
    x:Class="Azzs.Ui.Pages.SoftwareInstallationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsSoftwareInstallationPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="SoftwareInstallationPageTitle"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource AzzsPageTitleTextStyle}"
                TextWrapping="Wrap" />
            <InfoBar
                x:Name="LocalTrialInfoBar"
                x:Uid="SoftwareInstallationLocalTrial"
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsSoftwareInstallationLocalTrial"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Style="{StaticResource AzzsWarningStatusBandStyle}" />
            <InfoBar
                x:Name="SoftwareCatalogStatusInfoBar"
                Grid.Row="2"
                AutomationProperties.AutomationId="AzzsSoftwareInstallationCatalogStatus"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Style="{StaticResource AzzsStatusBandStyle}" />
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <Button
                    x:Name="CreateBatchButton"
                    x:Uid="SoftwareInstallationCreateBatch"
                    AutomationProperties.AutomationId="AzzsSoftwareInstallationCreateBatch"
                    Click="OnCreateBatch" />
            </StackPanel>
            <StackPanel
                x:Name="BasicSoftwareGroup"
                Grid.Row="4"
                Spacing="{StaticResource AzzsSpaceSmall}"
                AutomationProperties.AutomationId="AzzsSoftwareInstallationBasic">
                <TextBlock
                    x:Uid="SoftwareInstallationBasicTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="BasicSoftwareItems" Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
            <StackPanel
                x:Name="NormalSoftwareGroup"
                Grid.Row="5"
                Spacing="{StaticResource AzzsSpaceSmall}"
                AutomationProperties.AutomationId="AzzsSoftwareInstallationNormal">
                <TextBlock
                    x:Uid="SoftwareInstallationNormalTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="NormalSoftwareItems" Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
            <controls:ReadOnlyPresentationSurface
                x:Name="SoftwareSelectionStatus"
                Grid.Row="6" />
            <controls:ReadOnlyPresentationSurface
                x:Name="OfflinePackageCacheStatus"
                Grid.Row="7" />
            <controls:ReadOnlyPresentationSurface
                x:Name="InstallationBatchStatus"
                Grid.Row="8" />
        </Grid>
    </ScrollViewer>
</Page>
