<Page
    x:Class="Azzs.Ui.Pages.SystemOptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsSystemOptimizationPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0">
                <controls:PageHeader.TitleContent>
                    <TextBlock
                        x:Uid="SystemOptimizationPageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource AzzsPageTitleTextStyle}"
                        TextWrapping="Wrap" />
                </controls:PageHeader.TitleContent>
            </controls:PageHeader>
            <InfoBar
                x:Name="SystemSettingsStatus"
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsSystemSettingsStatus"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Style="{StaticResource AzzsStatusBandStyle}" />
            <StackPanel
                Grid.Row="2"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <TextBlock
                    x:Uid="SystemSettingsRecommendedTitle"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="RecommendedSummary"
                    AutomationProperties.AutomationId="AzzsSystemOptimizationSummary"
                    Style="{StaticResource AzzsBodyTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                    <Button
                        x:Name="SelectRecommendedButton"
                        AutomationProperties.AutomationId="AzzsSelectRecommendedSystemSettings"
                        Click="OnSelectRecommended">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                            <SymbolIcon Symbol="AllApps" />
                            <TextBlock x:Uid="SystemSettingsSelectRecommendedButtonText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ApplySelectedButton"
                        AutomationProperties.AutomationId="AzzsApplySelectedSystemSettings"
                        Click="OnApplySelected">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                            <SymbolIcon Symbol="Accept" />
                            <TextBlock x:Uid="SystemSettingsApplySelectedButtonText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RestartExplorerButton"
                        AutomationProperties.AutomationId="AzzsRestartExplorerNow"
                        Click="OnRestartExplorerNow"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock x:Uid="SystemSettingsRestartExplorerButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="RestartExplorerNotice"
                    x:Uid="SystemSettingsRestartExplorerNotice"
                    Style="{StaticResource AzzsMetadataTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
            <StackPanel
                x:Name="SettingsItems"
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsSystemOptimizationItems"
                Spacing="{StaticResource AzzsSpaceStandard}" />
            <StackPanel
                Grid.Row="4"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <TextBlock
                    x:Uid="SystemSettingsRecoveryTitle"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="RecoveryDeletionNotice"
                    Style="{StaticResource AzzsMetadataTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="RecoveryItems"
                    AutomationProperties.AutomationId="AzzsSystemSettingsRecoveryItems"
                    Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
