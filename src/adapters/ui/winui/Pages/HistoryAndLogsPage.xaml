<Page
    x:Class="Azzs.Ui.Pages.HistoryAndLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="AzzsHistoryAndLogsPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="HistoryAndLogsPageTitle"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource AzzsPageTitleTextStyle}"
                TextWrapping="Wrap" />
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsHistoryAndLogsStatus"
                IsClosable="False"
                IsOpen="False" />
            <CommandBar
                Grid.Row="2"
                AutomationProperties.AutomationId="AzzsHistoryAndLogsCommands"
                DefaultLabelPosition="Right">
                <AppBarButton
                    x:Name="RefreshButton"
                    x:Uid="HistoryAndLogsRefreshButton"
                    AutomationProperties.AutomationId="AzzsHistoryAndLogsRefresh"
                    Click="OnRefresh">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="ExportDiagnosticButton"
                    x:Uid="HistoryAndLogsExportDiagnosticButton"
                    AutomationProperties.AutomationId="AzzsHistoryAndLogsExportDiagnostic"
                    Click="OnExportDiagnostic">
                    <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="ClearLogsButton"
                    x:Uid="HistoryAndLogsClearLogsButton"
                    AutomationProperties.AutomationId="AzzsHistoryAndLogsClear"
                    Click="OnClearLogs">
                    <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <TextBlock
                x:Name="DiagnosticPreviewText"
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsHistoryAndLogsDiagnosticPreview"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="FilterTextBox"
                x:Uid="HistoryAndLogsFilter"
                Grid.Row="4"
                AutomationProperties.AutomationId="AzzsHistoryAndLogsFilter"
                TextChanged="OnFilterChanged" />
            <StackPanel
                Grid.Row="5"
                AutomationProperties.AutomationId="AzzsHistoryRecords"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <TextBlock
                    x:Uid="HistoryAndLogsHistoryTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HistoryEmptyText"
                    x:Uid="HistoryAndLogsHistoryEmpty"
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="HistoryItems"
                    Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
            <StackPanel
                Grid.Row="6"
                AutomationProperties.AutomationId="AzzsLogRecords"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <TextBlock
                    x:Uid="HistoryAndLogsLogTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LogSummaryText"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LogEmptyText"
                    x:Uid="HistoryAndLogsLogEmpty"
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="LogItems"
                    Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
