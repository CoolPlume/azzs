<Page
    x:Class="Azzs.Ui.Pages.SoftwareCatalogEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0">
                <controls:PageHeader.TitleContent>
                    <TextBlock
                        x:Uid="SoftwareCatalogEditorPageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource AzzsPageTitleTextStyle}"
                        TextWrapping="Wrap" />
                </controls:PageHeader.TitleContent>
            </controls:PageHeader>
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorStatus"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Style="{StaticResource AzzsStatusBandStyle}" />
            <InfoBar
                x:Name="LocalTrialInfoBar"
                Grid.Row="2"
                x:Uid="SoftwareCatalogEditorLocalTrial"
                AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalTrial"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Style="{StaticResource AzzsWarningStatusBandStyle}" />
            <InfoBar
                x:Name="RuntimeIssuesInfoBar"
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorRuntimeIssues"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Style="{StaticResource AzzsStatusBandStyle}" />
            <InfoBar
                x:Name="ReleaseIssuesInfoBar"
                Grid.Row="4"
                AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorReleaseIssues"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Style="{StaticResource AzzsWarningStatusBandStyle}" />
            <CommandBar
                Grid.Row="5"
                AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCommands"
                DefaultLabelPosition="Right">
                <AppBarButton x:Name="AddSoftwareButton" x:Uid="SoftwareCatalogEditorAdd" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorAdd" Click="OnAddSoftware">
                    <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DuplicateSoftwareButton" x:Uid="SoftwareCatalogEditorDuplicate" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDuplicate" Click="OnDuplicateSoftware">
                    <AppBarButton.Icon><SymbolIcon Symbol="Copy" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteSoftwareButton" x:Uid="SoftwareCatalogEditorDelete" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDelete" Click="OnDeleteSoftware">
                    <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="SaveDraftButton" x:Uid="SoftwareCatalogEditorSaveDraft" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSaveDraft" Click="OnSaveDraft">
                    <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteSavedDraftButton" x:Uid="SoftwareCatalogEditorDeleteSavedDraft" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDeleteSavedDraft" Click="OnDeleteSavedDraft">
                    <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ApplySavedDraftButton" x:Uid="SoftwareCatalogEditorApply" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorApply" Click="OnApplySavedDraft">
                    <AppBarButton.Icon><SymbolIcon Symbol="Upload" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DiscardUnsavedButton" x:Uid="SoftwareCatalogEditorDiscard" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDiscard" Click="OnDiscardUnsaved">
                    <AppBarButton.Icon><SymbolIcon Symbol="Cancel" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <Grid
                Grid.Row="6"
                RowSpacing="{StaticResource AzzsSpaceSmall}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    x:Uid="SoftwareCatalogEditorSearch"
                    AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSearch"
                    TextChanged="OnSearchChanged" />
                <StackPanel Grid.Row="1" Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBox
                        x:Name="ImportPathTextBox"
                        x:Uid="SoftwareCatalogEditorImportPath"
                        AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorImportPath"
                        TextChanged="OnImportPathChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                        <Button x:Name="PreviewImportButton" x:Uid="SoftwareCatalogEditorPreviewImport" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorPreviewImport" Click="OnPreviewImport">
                            <Button.Content><StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}"><SymbolIcon Symbol="Folder" /><TextBlock x:Uid="SoftwareCatalogEditorPreviewImportLabel" /></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="ApplyImportButton" x:Uid="SoftwareCatalogEditorApplyImport" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorApplyImport" Click="OnApplyImport">
                            <Button.Content><StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}"><SymbolIcon Symbol="Upload" /><TextBlock x:Uid="SoftwareCatalogEditorApplyImportLabel" /></StackPanel></Button.Content>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="ImportPreviewText"
                        AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorImportPreview"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource AzzsMetadataTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="7"
                ColumnSpacing="{StaticResource AzzsSpaceStandard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock x:Uid="SoftwareCatalogEditorListTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                    <ListView
                        x:Name="SoftwareList"
                        AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorList"
                        MinHeight="{StaticResource AzzsTouchTargetMinHeight}"
                        SelectionChanged="OnSoftwareSelectionChanged" />
                    <TextBlock x:Uid="SoftwareCatalogEditorCategoryListTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                    <AppBarButton x:Name="AddCategoryButton" x:Uid="SoftwareCatalogEditorAddCategory" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorAddCategory" Click="OnAddCategory">
                        <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
                    </AppBarButton>
                    <ListView
                        x:Name="CategoryList"
                        AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryList"
                        MaxHeight="144"
                        SelectionChanged="OnCategorySelectionChanged" />
                    <TextBox x:Name="CategoryIdTextBox" x:Uid="SoftwareCatalogEditorCategoryId" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryId" LostFocus="OnCategoryFieldLostFocus" />
                    <TextBox x:Name="CategoryNameTextBox" x:Uid="SoftwareCatalogEditorCategoryName" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryName" LostFocus="OnCategoryFieldLostFocus" />
                    <TextBlock x:Uid="SoftwareCatalogEditorCategoryLocalizationListTitle" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                        <AppBarButton x:Name="AddCategoryLocalizationButton" x:Uid="SoftwareCatalogEditorAddCategoryLocalization" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorAddCategoryLocalization" Click="OnAddCategoryLocalization"><AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon></AppBarButton>
                        <AppBarButton x:Name="DeleteCategoryLocalizationButton" x:Uid="SoftwareCatalogEditorDeleteCategoryLocalization" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDeleteCategoryLocalization" Click="OnDeleteCategoryLocalization"><AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon></AppBarButton>
                    </StackPanel>
                    <ListView x:Name="CategoryLocalizationList" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryLocalizationList" MaxHeight="144" SelectionChanged="OnCategoryLocalizationSelectionChanged" />
                    <TextBox x:Name="CategoryLocalizationLocaleTextBox" x:Uid="SoftwareCatalogEditorCategoryLocalizationLocale" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryLocalizationLocale" LostFocus="OnCategoryLocalizationFieldLostFocus" />
                    <TextBox x:Name="CategoryLocalizationNameTextBox" x:Uid="SoftwareCatalogEditorCategoryLocalizationName" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategoryLocalizationName" LostFocus="OnCategoryLocalizationFieldLostFocus" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AzzsDetailSurfaceStyle}">
                    <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                        <TextBlock x:Uid="SoftwareCatalogEditorDetailTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                        <TextBox x:Name="SoftwareIdTextBox" x:Uid="SoftwareCatalogEditorId" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorId" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareNameTextBox" x:Uid="SoftwareCatalogEditorName" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorName" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareBranchTextBox" x:Uid="SoftwareCatalogEditorBranch" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorBranch" LostFocus="OnSoftwareFieldLostFocus" />
                        <ComboBox x:Name="SoftwareCategoryComboBox" x:Uid="SoftwareCatalogEditorCategory" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorCategory" SelectionChanged="OnSoftwareFieldSelectionChanged" />
                        <ComboBox x:Name="SoftwareTierComboBox" x:Uid="SoftwareCatalogEditorTier" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorTier" SelectionChanged="OnSoftwareFieldSelectionChanged">
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorTierBasic" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorTierNormal" />
                        </ComboBox>
                        <ComboBox x:Name="SoftwareVersionPolicyComboBox" x:Uid="SoftwareCatalogEditorVersionPolicy" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorVersionPolicy" SelectionChanged="OnSoftwareFieldSelectionChanged">
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorVersionLatestStable" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorVersionLatestStableWithHistory" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorVersionFixed" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorVersionMaintainerProvided" />
                        </ComboBox>
                        <TextBox x:Name="SoftwareFixedVersionTextBox" x:Uid="SoftwareCatalogEditorFixedVersion" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorFixedVersion" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareInstallProfileTextBox" x:Uid="SoftwareCatalogEditorInstallProfile" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorInstallProfile" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareDependenciesTextBox" x:Uid="SoftwareCatalogEditorDependencies" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDependencies" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareBundledEditionsTextBox" x:Uid="SoftwareCatalogEditorBundledEditions" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorBundledEditions" LostFocus="OnSoftwareFieldLostFocus" />
                        <TextBox x:Name="SoftwareNoticeTextBox" x:Uid="SoftwareCatalogEditorNotice" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorNotice" AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnSoftwareFieldLostFocus" />
                        <ToggleSwitch x:Name="SoftwareEnabledToggle" x:Uid="SoftwareCatalogEditorEnabled" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorEnabled" Toggled="OnSoftwareEnabledToggled" />
                        <TextBlock x:Uid="SoftwareCatalogEditorSourceListTitle" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                            <AppBarButton x:Name="AddSourceButton" x:Uid="SoftwareCatalogEditorAddSource" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorAddSource" Click="OnAddSource"><AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton x:Name="DeleteSourceButton" x:Uid="SoftwareCatalogEditorDeleteSource" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDeleteSource" Click="OnDeleteSource"><AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon></AppBarButton>
                        </StackPanel>
                        <ListView x:Name="SourceList" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSourceList" MaxHeight="144" SelectionChanged="OnSourceSelectionChanged" />
                        <ComboBox x:Name="SourcePurposeComboBox" x:Uid="SoftwareCatalogEditorSourcePurpose" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSourcePurpose" SelectionChanged="OnSourceFieldSelectionChanged">
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorSourcePrimary" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorSourceAlternative" />
                            <ComboBoxItem x:Uid="SoftwareCatalogEditorSourceProjectBackup" />
                        </ComboBox>
                        <TextBox x:Name="SourceAddressTextBox" x:Uid="SoftwareCatalogEditorSourceAddress" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSourceAddress" LostFocus="OnSourceFieldLostFocus" />
                        <TextBox x:Name="SourceVersionTextBox" x:Uid="SoftwareCatalogEditorSourceVersion" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorSourceVersion" LostFocus="OnSourceFieldLostFocus" />
                        <TextBlock x:Uid="SoftwareCatalogEditorLocalizationListTitle" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                            <AppBarButton x:Name="AddLocalizationButton" x:Uid="SoftwareCatalogEditorAddLocalization" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorAddLocalization" Click="OnAddLocalization"><AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton x:Name="DeleteLocalizationButton" x:Uid="SoftwareCatalogEditorDeleteLocalization" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDeleteLocalization" Click="OnDeleteLocalization"><AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon></AppBarButton>
                        </StackPanel>
                        <ListView x:Name="LocalizationList" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationList" MaxHeight="144" SelectionChanged="OnLocalizationSelectionChanged" />
                        <TextBox x:Name="LocalizationLocaleTextBox" x:Uid="SoftwareCatalogEditorLocalizationLocale" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationLocale" LostFocus="OnLocalizationFieldLostFocus" />
                        <TextBox x:Name="LocalizationNameTextBox" x:Uid="SoftwareCatalogEditorLocalizationName" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationName" LostFocus="OnLocalizationFieldLostFocus" />
                        <TextBox x:Name="LocalizationNoticeTextBox" x:Uid="SoftwareCatalogEditorLocalizationNotice" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationNotice" AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnLocalizationFieldLostFocus" />
                        <TextBox x:Name="LocalizationOptimizationNoteTextBox" x:Uid="SoftwareCatalogEditorLocalizationOptimizationNote" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationOptimizationNote" AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnLocalizationFieldLostFocus" />
                        <TextBox x:Name="LocalizationEducationDescriptionTextBox" x:Uid="SoftwareCatalogEditorLocalizationEducationDescription" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorLocalizationEducationDescription" AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnLocalizationFieldLostFocus" />
                        <TextBlock x:Name="DraftStateText" AutomationProperties.AutomationId="AzzsSoftwareCatalogEditorDraftState" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
