<Page
    x:Class="Azzs.Ui.Pages.SoftwareOptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="AzzsSoftwareOptimizationPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="SoftwareOptimizationPageTitle"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource AzzsPageTitleTextStyle}"
                TextWrapping="Wrap" />
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="AzzsSoftwareOptimizationStatus"
                IsOpen="False"
                IsClosable="False" />
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="{StaticResource AzzsSpaceSmall}">
                <Button
                    x:Name="RefreshButton"
                    x:Uid="SoftwareOptimizationRefreshButton"
                    AutomationProperties.AutomationId="AzzsSoftwareOptimizationRefresh"
                    Click="OnRefresh" />
                <Button
                    x:Name="PrepareSelectedButton"
                    x:Uid="SoftwareOptimizationPrepareSelectedButton"
                    AutomationProperties.AutomationId="AzzsSoftwareOptimizationPrepareSelected"
                    Click="OnPrepareSelected" />
            </StackPanel>
            <StackPanel
                x:Name="CanOptimizeGroup"
                Grid.Row="3"
                AutomationProperties.AutomationId="AzzsSoftwareOptimizationCanOptimize">
                <TextBlock
                    x:Uid="SoftwareOptimizationCanOptimizeTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="CanOptimizeItems" Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
            <StackPanel
                x:Name="NeedsAttentionGroup"
                Grid.Row="4"
                AutomationProperties.AutomationId="AzzsSoftwareOptimizationNeedsAttention">
                <TextBlock
                    x:Uid="SoftwareOptimizationNeedsAttentionTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="NeedsAttentionItems" Spacing="{StaticResource AzzsSpaceSmall}" />
            </StackPanel>
            <StackPanel
                x:Name="OptimizedGroup"
                Grid.Row="5"
                AutomationProperties.AutomationId="AzzsSoftwareOptimizationOptimized">
                <TextBlock
                    x:Uid="SoftwareOptimizationOptimizedTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource AzzsSectionTitleTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="OptimizedItems" Spacing="{StaticResource AzzsSpaceSmall}" />
                <Expander
                    x:Name="NoAvailableOptimizationExpander"
                    x:Uid="SoftwareOptimizationNoAvailableExpander"
                    Margin="{StaticResource AzzsTopMarginLarge}"
                    AutomationProperties.AutomationId="AzzsSoftwareOptimizationNoAvailable">
                    <StackPanel x:Name="NoAvailableItems" Spacing="{StaticResource AzzsSpaceSmall}" />
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
