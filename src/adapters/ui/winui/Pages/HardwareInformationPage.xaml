<Page
    x:Class="Azzs.Ui.Pages.HardwareInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsHardwareInformationPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0">
                <controls:PageHeader.TitleContent>
                    <TextBlock x:Uid="HardwareInformationPageTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource AzzsPageTitleTextStyle}" TextWrapping="Wrap" />
                </controls:PageHeader.TitleContent>
                <controls:PageHeader.CommandContent>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}">
                        <Button x:Name="CopyHardwareButton" AutomationProperties.AutomationId="AzzsHardwareCopySection" Click="OnCopyHardwareClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}"><SymbolIcon Symbol="Copy" /><TextBlock x:Uid="HardwareCopySection" /></StackPanel>
                        </Button>
                        <Button x:Name="RefreshHardwareButton" AutomationProperties.AutomationId="AzzsHardwareRefresh" Click="OnRefreshClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AzzsSpaceSmall}"><SymbolIcon Symbol="Refresh" /><TextBlock x:Uid="HardwareInformationRefresh" /></StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageHeader.CommandContent>
            </controls:PageHeader>
            <InfoBar x:Name="HardwareStatus" Grid.Row="1" AutomationProperties.AutomationId="AzzsHardwareStatus" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Style="{StaticResource AzzsStatusBandStyle}" />
            <Border Grid.Row="2" AutomationProperties.AutomationId="AzzsHardwareDetails" Style="{StaticResource AzzsDetailSurfaceStyle}">
                <Grid x:Name="HardwareDetailsGrid" ColumnSpacing="{StaticResource AzzsSpaceStandard}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource AzzsHardwareTypeColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="HardwareInformationFieldHeader" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Uid="HardwareInformationValueHeader" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelLabel" Grid.Row="1" Grid.Column="0" x:Uid="HardwareModelLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="ModelValue" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareModel" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OperatingSystemLabel" Grid.Row="2" Grid.Column="0" x:Uid="HardwareOperatingSystemLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="OperatingSystemValue" Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareOperatingSystem" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CpuLabel" Grid.Row="3" Grid.Column="0" x:Uid="HardwareCpuLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="CpuValue" Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareCpu" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MotherboardLabel" Grid.Row="4" Grid.Column="0" x:Uid="HardwareMotherboardLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="MotherboardValue" Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareMotherboard" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MemoryLabel" Grid.Row="5" Grid.Column="0" x:Uid="HardwareMemoryLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="MemoryValue" Grid.Row="5" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareMemory" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="GpuLabel" Grid.Row="6" Grid.Column="0" x:Uid="HardwareGpuLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="GpuValue" Grid.Row="6" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareGpu" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DisplayLabel" Grid.Row="7" Grid.Column="0" x:Uid="HardwareDisplayLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="DisplayValue" Grid.Row="7" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareDisplay" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SolidStateStorageLabel" Grid.Row="8" Grid.Column="0" x:Uid="HardwareSolidStateStorageLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="SolidStateStorageValue" Grid.Row="8" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareSolidStateStorage" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="HardDiskStorageLabel" Grid.Row="9" Grid.Column="0" x:Uid="HardwareHardDiskStorageLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="HardDiskStorageValue" Grid.Row="9" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareHardDiskStorage" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WiredNetworkLabel" Grid.Row="10" Grid.Column="0" x:Uid="HardwareWiredNetworkLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="WiredNetworkValue" Grid.Row="10" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareWiredNetwork" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WirelessNetworkLabel" Grid.Row="11" Grid.Column="0" x:Uid="HardwareWirelessNetworkLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="WirelessNetworkValue" Grid.Row="11" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareWirelessNetwork" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AudioLabel" Grid.Row="12" Grid.Column="0" x:Uid="HardwareAudioLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="AudioValue" Grid.Row="12" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareAudio" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="NpuLabel" Grid.Row="13" Grid.Column="0" x:Uid="HardwareNpuLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="NpuValue" Grid.Row="13" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareNpu" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="KeyboardLabel" Grid.Row="14" Grid.Column="0" x:Uid="HardwareKeyboardLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="KeyboardValue" Grid.Row="14" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareKeyboard" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MouseLabel" Grid.Row="15" Grid.Column="0" x:Uid="HardwareMouseLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="MouseValue" Grid.Row="15" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareMouse" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TouchpadLabel" Grid.Row="16" Grid.Column="0" x:Uid="HardwareTouchpadLabel" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" /><TextBlock x:Name="TouchpadValue" Grid.Row="16" Grid.Column="1" AutomationProperties.AutomationId="AzzsHardwareTouchpad" IsTextSelectionEnabled="True" Margin="{StaticResource AzzsHardwareRowTextMargin}" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
