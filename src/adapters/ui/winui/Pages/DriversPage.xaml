<Page
    x:Class="Azzs.Ui.Pages.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Azzs.Ui.DesignSystem.Controls"
    AutomationProperties.AutomationId="AzzsDriversPage">
    <ScrollViewer Style="{StaticResource AzzsPageScrollViewerStyle}">
        <Grid x:Name="PageRoot" Style="{StaticResource AzzsPageRootGridStyle}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveLayoutStates">
                    <VisualState x:Name="NarrowLayout"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePaddingNarrow}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="WideLayout"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="{StaticResource AzzsWideLayoutMinWidth}" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageRoot.Padding" Value="{StaticResource AzzsPagePadding}" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0"><controls:PageHeader.TitleContent><TextBlock x:Uid="DriversPageTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource AzzsPageTitleTextStyle}" TextWrapping="Wrap" /></controls:PageHeader.TitleContent></controls:PageHeader>
            <Border Grid.Row="1" x:Name="DriverHandoffSurface" AutomationProperties.AutomationId="AzzsDriverHandoffState" Style="{StaticResource AzzsSectionSurfaceStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock x:Name="DriverHandoffHeadline" Style="{StaticResource AzzsSectionTitleTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriverHandoffDescription" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="ExternalFlowReturnedButton" AutomationProperties.AutomationId="AzzsDriverExternalFlowReturned" Click="OnExternalFlowReturnedClicked" Style="{StaticResource AzzsPrimaryCommandButtonStyle}" Visibility="Collapsed"><TextBlock x:Uid="DriverExternalFlowReturnedButton" /></Button>
                    <StackPanel x:Name="DriverResultActions" AutomationProperties.AutomationId="AzzsDriverResultActions" Spacing="{StaticResource AzzsSpaceSmall}" Visibility="Collapsed">
                        <Button AutomationProperties.AutomationId="AzzsDriverResultCompleted" Click="OnDriverCompletedClicked" Style="{StaticResource AzzsPrimaryCommandButtonStyle}"><TextBlock x:Uid="DriverCompletedButton" /></Button>
                        <Button AutomationProperties.AutomationId="AzzsDriverResultRestart" Click="OnDriverRestartRequiredClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverRestartRequiredButton" /></Button>
                        <Button AutomationProperties.AutomationId="AzzsDriverResultSkip" Click="OnDriverSkipClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverSkipButton" /></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar x:Name="DriverRecommendation" Grid.Row="2" AutomationProperties.AutomationId="AzzsDriverRecommendation" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Style="{StaticResource AzzsStatusBandStyle}" />
            <Border Grid.Row="3" AutomationProperties.AutomationId="AzzsDriverEntrypoints" Style="{StaticResource AzzsSectionSurfaceStyle}">
                <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock x:Uid="DriverAssistantTitle" Style="{StaticResource AzzsSectionTitleTextStyle}" />
                    <TextBlock x:Uid="DriverAssistantDescription" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriverAssistantStatus" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="DriverAssistantActionButton" AutomationProperties.AutomationId="AzzsDriverAssistantAction" Click="OnDriverAssistantClicked" Style="{StaticResource AzzsPrimaryCommandButtonStyle}"><TextBlock x:Name="DriverAssistantActionText" /></Button>
                    <TextBlock x:Uid="FixedDriverEntrypointsTitle" Style="{StaticResource AzzsSectionTitleTextStyle}" />
                    <TextBlock x:Uid="FixedDriverEntrypointsDescription" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="IntelDriverButton" AutomationProperties.AutomationId="AzzsIntelDriverEntrypoint" Click="OnIntelDriverClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverIntelButton" /></Button>
                    <Button x:Name="NvidiaDriverButton" AutomationProperties.AutomationId="AzzsNvidiaDriverEntrypoint" Click="OnNvidiaDriverClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverNvidiaButton" /></Button>
                    <Button x:Name="DellSupportButton" AutomationProperties.AutomationId="AzzsDellSupportEntrypoint" Click="OnDellSupportClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverDellButton" /></Button>
                    <Button x:Name="HpSupportButton" AutomationProperties.AutomationId="AzzsHpSupportEntrypoint" Click="OnHpSupportClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverHpButton" /></Button>
                    <Button x:Name="LenovoSupportButton" AutomationProperties.AutomationId="AzzsLenovoSupportEntrypoint" Click="OnLenovoSupportClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverLenovoButton" /></Button>
                    <Button x:Name="AsusSupportButton" AutomationProperties.AutomationId="AzzsAsusSupportEntrypoint" Click="OnAsusSupportClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="DriverAsusButton" /></Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" AutomationProperties.AutomationId="AzzsFixedRescueToolFolders" Style="{StaticResource AzzsSectionSurfaceStyle}">
                <StackPanel Spacing="{StaticResource AzzsSpaceSmall}">
                    <TextBlock x:Uid="RescueToolFoldersTitle" Style="{StaticResource AzzsSectionTitleTextStyle}" />
                    <TextBlock x:Uid="RescueToolFoldersDescription" Style="{StaticResource AzzsMetadataTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="GenericNetworkDriverRescueDisplayName" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="GenericNetworkDriverRescueButton" AutomationProperties.AutomationId="AzzsGenericNetworkDriverRescueFolder" Click="OnGenericNetworkDriverRescueClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="GenericNetworkDriverRescueButton" /></Button>
                    <TextBlock x:Uid="OfflineNetworkDiagnosticsRescueDisplayName" Style="{StaticResource AzzsBodyTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="OfflineNetworkDiagnosticsRescueButton" AutomationProperties.AutomationId="AzzsOfflineNetworkDiagnosticsRescueFolder" Click="OnOfflineNetworkDiagnosticsRescueClicked" Style="{StaticResource AzzsSecondaryCommandButtonStyle}"><TextBlock x:Uid="OfflineNetworkDiagnosticsRescueButton" /></Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
